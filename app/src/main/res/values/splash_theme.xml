<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyFEFU.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fefu_blue</item> <!-- Фон заставки -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/fefu_logo_foreground</item> <!-- Ваша иконка -->
        <item name="windowSplashScreenAnimationDuration">1000</item> <!-- Длительность анимации -->
        <item name="postSplashScreenTheme">@style/Theme.MyFEFU</item> <!-- Тема после заставки -->

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>